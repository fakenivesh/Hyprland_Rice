{
  "layer": "top",
  "position": "top",
  "height": 38,
  "spacing": 4,
  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": ["pulseaudio", "memory", "cpu", "tray"],
  "hyprland/workspaces": {
    "format": "{name}",
    "all-outputs": true,
    "disable-scroll": true,
    "on-click": "activate"
  },
  "hyprland/window": {
    "max-length": 42,
    "separate-outputs": true
  },
  "clock": {
    "format": "  {:%a, %d %b}     {:%H:%M}",
    "tooltip": false,
    "interval": 30
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰖁 muted",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },
  "memory": {
    "format": "RAM {percentage}%",
    "tooltip": false
  },
  "cpu": {
    "format": "CPU {usage}%",
    "tooltip": false
  },
  "tray": {
    "spacing": 8
  }
}
